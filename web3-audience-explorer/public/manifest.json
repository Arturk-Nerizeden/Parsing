{
  "manifest_version": 3,
  "name": "Web3 Audience Explorer",
  "description": "Research X audiences through the official Sorsa API. Local collections and CSV export.",
  "version": "1.0.2",
  "minimum_chrome_version": "120",
  "permissions": ["storage"],
  "host_permissions": ["https://api.sorsa.io/*"],
  "action": { "default_title": "Open Web3 Audience Explorer" },
  "background": { "service_worker": "background.js", "type": "module" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
