{
  "name": "telegram-outreach",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Standalone Chrome extension for Telegram contact messaging through MTProto",
  "scripts": {
    "build": "tsc --noEmit && vite build && node scripts/verify-build.mjs",
    "test": "vitest run",
    "test:browser": "npm run build && node tests/browser-smoke.mjs",
    "package": "npm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "@mtcute/web": "0.32.6",
    "long": "5.3.2"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.318",
    "@types/node": "^22.20.5",
    "acorn": "^8.19.0",
    "fflate": "^0.8.3",
    "playwright": "^1.64.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
