{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": ["chrome", "vitest/globals", "node"],
    "strict": true, "skipLibCheck": true, "noEmit": true, "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true, "useDefineForClassFields": true
  },
  "include": ["src", "tests", "vite.config.ts"]
}
